{
    "name": "@metagrapher/zem",
    "version": "1.0.0",
    "type": "module",
    "description": "Zero-Exception Monadic Methodology Core Library",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "zem": "./bin/zem.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./eslint": {
            "types": "./dist/eslint/index.d.ts",
            "import": "./dist/eslint/index.js"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts src/eslint/index.ts --format esm,cjs --dts --clean",
        "prepare": "npm run build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "structural-check": "node --loader ts-node/esm scripts/structural-audit.ts",
        "zem": "npm run structural-check && npm run typecheck && npm run test:coverage",
        "watch:tests": "node --loader ts-node/esm scripts/scaffold-tests.ts",
        "dev": "tsup src/index.ts --format esm --watch --dts"
    },
    "keywords": [
        "monad",
        "functional",
        "result",
        "zero-exception",
        "zem"
    ],
    "author": "Metagrapher",
    "license": "MIT",
    "devDependencies": {
        "@metagrapher/zem": "file:.",
        "@types/eslint": "^9.6.1",
        "@types/node": "^25.2.0",
        "@vitest/coverage-v8": "^4.0.18",
        "eslint": "^9.20.1",
        "ts-node": "^10.9.2",
        "tsup": "^8.3.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0",
        "vitest": "^4.0.17"
    }
}